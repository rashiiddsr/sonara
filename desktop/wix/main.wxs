<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

  <?ifdef JpIsSystemWide ?>
    <?define JpInstallScope="perMachine"?>
  <?else?>
    <?define JpInstallScope="perUser"?>
  <?endif?>

  <?define JpProductLanguage=1033 ?>
  <?define JpInstallerVersion=200 ?>
  <?define JpCompressedMsi=yes ?>

  <?include $(var.JpConfigDir)/overrides.wxi ?>

  <?ifdef JpAllowUpgrades ?>
    <?define JpUpgradeVersionOnlyDetectUpgrade="no"?>
  <?else?>
    <?define JpUpgradeVersionOnlyDetectUpgrade="yes"?>
  <?endif?>
  <?ifdef JpAllowDowngrades ?>
    <?define JpUpgradeVersionOnlyDetectDowngrade="no"?>
  <?else?>
    <?define JpUpgradeVersionOnlyDetectDowngrade="yes"?>
  <?endif?>

  <Product
    Id="*"
    Name="$(var.JpAppName)"
    Language="$(var.JpProductLanguage)"
    Version="$(var.JpAppVersion)"
    Manufacturer="$(var.JpAppVendor)"
    UpgradeCode="$(var.JpProductUpgradeCode)">

    <Package
      Description="$(var.JpAppDescription)"
      Manufacturer="$(var.JpAppVendor)"
      InstallerVersion="$(var.JpInstallerVersion)"
      Compressed="$(var.JpCompressedMsi)"
      InstallScope="$(var.JpInstallScope)" Platform="x64"
    />

    <Media Id="1" Cabinet="Data.cab" EmbedCab="yes" />

    <Upgrade Id="$(var.JpProductUpgradeCode)">
      <UpgradeVersion
        OnlyDetect="$(var.JpUpgradeVersionOnlyDetectUpgrade)"
        Property="JP_UPGRADABLE_FOUND"
        Maximum="$(var.JpAppVersion)"
        MigrateFeatures="yes"
        IncludeMaximum="yes" />
      <UpgradeVersion
        OnlyDetect="$(var.JpUpgradeVersionOnlyDetectDowngrade)"
        Property="JP_DOWNGRADABLE_FOUND"
        Minimum="$(var.JpAppVersion)"
        MigrateFeatures="yes"
        IncludeMinimum="$(var.JpUpgradeVersionOnlyDetectDowngrade)" />
    </Upgrade>

    <?ifndef JpAllowUpgrades ?>
    <CustomAction Id="JpDisallowUpgrade" Error="!(loc.DisallowUpgradeErrorMessage)" />
    <?endif?>
    <?ifndef JpAllowDowngrades ?>
    <CustomAction Id="JpDisallowDowngrade" Error="!(loc.DowngradeErrorMessage)" />
    <?endif?>

    <Binary Id="JpCaDll" SourceFile="wixhelper.dll"/>

    <CustomAction Id="JpFindRelatedProducts" BinaryKey="JpCaDll" DllEntry="FindRelatedProductsEx" />

    <!-- Standard required root -->
    <Directory Id="TARGETDIR" Name="SourceDir"/>

    <Feature Id="DefaultFeature" Title="!(loc.MainFeatureTitle)" Level="1">
      <ComponentGroupRef Id="Shortcuts"/>
      <ComponentGroupRef Id="Files"/>
      <ComponentGroupRef Id="FileAssociations"/>
    </Feature>

    <CustomAction Id="JpSetARPINSTALLLOCATION" Property="ARPINSTALLLOCATION" Value="[INSTALLDIR]" />
    <CustomAction Id="JpSetARPCOMMENTS" Property="ARPCOMMENTS" Value="$(var.JpAppDescription)" />
    <CustomAction Id="JpSetARPCONTACT" Property="ARPCONTACT" Value="$(var.JpAppVendor)" />
    <CustomAction Id="JpSetARPSIZE" Property="ARPSIZE" Value="$(var.JpAppSizeKb)" />

    <?ifdef JpHelpURL ?>
      <CustomAction Id="JpSetARPHELPLINK" Property="ARPHELPLINK" Value="$(var.JpHelpURL)" />
    <?endif?>

    <?ifdef JpAboutURL ?>
      <CustomAction Id="JpSetARPURLINFOABOUT" Property="ARPURLINFOABOUT" Value="$(var.JpAboutURL)" />
    <?endif?>

    <?ifdef JpUpdateURL ?>
      <CustomAction Id="JpSetARPURLUPDATEINFO" Property="ARPURLUPDATEINFO" Value="$(var.JpUpdateURL)" />
    <?endif?>

    <?ifdef JpIcon ?>
    <Property Id="ARPPRODUCTICON" Value="JpARPPRODUCTICON"/>
    <Icon Id="JpARPPRODUCTICON" SourceFile="$(var.JpIcon)"/>
    <?endif?>

    <!-- Sonara: the logo on the installer's pages -->
    <WixVariable Id="WixUIBannerBmp" Value="$(env.SONARA_WIX)\banner.bmp"/>
    <WixVariable Id="WixUIDialogBmp" Value="$(env.SONARA_WIX)\dialog.bmp"/>

    <!-- Sonara: "Open Sonara" on the last page, ticked -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Open Sonara"/>
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1"/>
    <CustomAction Id="SonaraOpen" Directory="INSTALLDIR" ExeCommand="&quot;[INSTALLDIR]$(var.JpAppName).exe&quot;" Return="asyncNoWait" Impersonate="yes"/>
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="SonaraOpen">WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed</Publish>
      <!-- Sonara: an update goes from the welcome page straight to Install: the licence and the
           folder were settled the first time, and the update keeps the same folder. -->
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="9">JP_UPGRADABLE_FOUND</Publish>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="9">JP_UPGRADABLE_FOUND</Publish>
    </UI>

    <!-- Sonara: before anything is replaced or removed (updates and uninstalls alike), and before
         an older version's uninstaller runs as part of an update:
         1. close the running app, so Windows never has to ask for it to be closed by hand;
         2. take away the older versions' "remove this folder" entries (RM_RF...): up to 2.4.1 that
            folder held the user's data too, and the old uninstaller emptied it on every update;
         3. move data from where 2.4.1 kept it (Sonara\data) to where it lives now (Sonara Data).
         It runs as the user and needs no administrator. It finds the app by its own name, and the
         user's registry by its SID (under the installer, HKCU is not the user's). -->
    <Property Id="WixQuietExecCmdLine" Value="&quot;[SystemFolder]cmd.exe&quot; /d /c taskkill.exe /F /T /IM $(var.JpAppName).exe &gt;nul 2&gt;&amp;1 &amp; ping.exe -n 3 127.0.0.1 &gt;nul &amp; (for /f &quot;delims=&quot; %k in ('reg.exe query &quot;HKU\[UserSID]\Software\$(var.JpAppVendor)\$(var.JpAppName)&quot; 2^&gt;nul') do @reg.exe delete &quot;%k&quot; /v RM_RF48431AECBD69377EA800D62616352F20 /f &gt;nul 2&gt;&amp;1) &amp; if exist &quot;%LOCALAPPDATA%\$(var.JpAppName)\data\&quot; if not exist &quot;%LOCALAPPDATA%\$(var.JpAppName) Data\&quot; move /y &quot;%LOCALAPPDATA%\$(var.JpAppName)\data&quot; &quot;%LOCALAPPDATA%\$(var.JpAppName) Data&quot; &gt;nul"/>
    <CustomAction Id="SonaraCloseRunning" BinaryKey="WixCA" DllEntry="WixQuietExec" Execute="immediate" Return="ignore"/>

    <!-- Sonara: on a real uninstall (not the one an update does), ask what to do with the user's
         data: keep it, back it up then delete it, or delete it. SONARA_DATA=keep|delete answers
         for silent uninstalls; with no answer and no UI, the data is kept. -->
    <!-- Sonara: on a real uninstall, the entry that opens Sonara at sign-in goes too (it would
         only fail). The user's registry is named by its SID: under the installer, HKCU is not the
         user's. -->
    <CustomAction Id="SonaraSetRunEntryCleanup" Property="WixQuietExecCmdLine" Value="&quot;[SystemFolder]reg.exe&quot; delete &quot;HKU\[UserSID]\Software\Microsoft\Windows\CurrentVersion\Run&quot; /v $(var.JpAppName) /f"/>
    <CustomAction Id="SonaraRemoveRunEntry" BinaryKey="WixCA" DllEntry="WixQuietExec" Execute="immediate" Return="ignore"/>

    <!-- Run with the app's own Java, not Sonara.exe: that launcher hands the app to a second
         process, which the installer wouldn't wait for (UninstallMain.kt). -->
    <CustomAction Id="SonaraAskAboutData" Directory="INSTALLDIR" ExeCommand="&quot;[INSTALLDIR]runtime\bin\javaw.exe&quot; -cp &quot;[INSTALLDIR]app\*&quot; &quot;-Djpackage.app-path=[INSTALLDIR]$(var.JpAppName).exe&quot; &quot;-Dsonara.localappdata=[LocalAppDataFolder].&quot; com.ermusic.desktop.UninstallMain [SONARA_DATA]" Execute="deferred" Impersonate="yes" Return="ignore"/>

    <UIRef Id="JpUI"/>

    <InstallExecuteSequence>
      <Custom Action="JpSetARPINSTALLLOCATION" After="CostFinalize">Not Installed</Custom>
      <Custom Action="JpSetARPCOMMENTS" After="CostFinalize">Not Installed</Custom>
      <Custom Action="JpSetARPCONTACT" After="CostFinalize">Not Installed</Custom>
      <Custom Action="JpSetARPSIZE" After="CostFinalize">Not Installed</Custom>
      <?ifdef JpHelpURL ?>
        <Custom Action="JpSetARPHELPLINK" After="CostFinalize">Not Installed</Custom>
      <?endif?>
      <?ifdef JpAboutURL ?>
        <Custom Action="JpSetARPURLINFOABOUT" After="CostFinalize">Not Installed</Custom>
      <?endif?>
      <?ifdef JpUpdateURL ?>
        <Custom Action="JpSetARPURLUPDATEINFO" After="CostFinalize">Not Installed</Custom>
      <?endif?>

      <?ifndef JpAllowUpgrades ?>
      <Custom Action="JpDisallowUpgrade" After="JpFindRelatedProducts">JP_UPGRADABLE_FOUND</Custom>
      <?endif?>
      <?ifndef JpAllowDowngrades ?>
      <Custom Action="JpDisallowDowngrade" After="JpFindRelatedProducts">JP_DOWNGRADABLE_FOUND</Custom>
      <?endif?>
      <RemoveExistingProducts Before="CostInitialize"/>
      <Custom Action="JpFindRelatedProducts" After="FindRelatedProducts"/>
      <Custom Action="SonaraCloseRunning" After="JpFindRelatedProducts"/>
      <Custom Action="SonaraSetRunEntryCleanup" After="SonaraCloseRunning">REMOVE~="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
      <Custom Action="SonaraRemoveRunEntry" After="SonaraSetRunEntryCleanup">REMOVE~="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
      <Custom Action="SonaraAskAboutData" Before="RemoveFiles">REMOVE~="ALL" AND NOT UPGRADINGPRODUCTCODE AND (UILevel&gt;2 OR SONARA_DATA)</Custom>
    </InstallExecuteSequence>

    <InstallUISequence>
      <Custom Action="JpFindRelatedProducts" After="FindRelatedProducts"/>
      <Custom Action="SonaraCloseRunning" After="JpFindRelatedProducts"/>
    </InstallUISequence>

  </Product>
</Wix>
